# Redis (local development)
REDIS_URL=redis://localhost:6379/0

# ChromaDB: leave CHROMA_HOST blank to use the local persistent store.
# Docker Compose overrides this with its `chroma` service.
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Embeddings. The collection is automatically suffixed with model and dimension.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=
RAG_COLLECTION_PREFIX=rag
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM
ANTHROPIC_API_KEY=
